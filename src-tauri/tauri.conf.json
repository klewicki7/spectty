{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spectty",
  "version": "0.0.0",
  "identifier": "app.spectty.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter ui dev",
    "beforeBuildCommand": "bash scripts/build-sidecars.sh && pnpm --filter ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Spectty",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
